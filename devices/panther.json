{
  "device": {
    "group": "pantah",
    "source_repo": "https://github.com/GrapheneOS/device_google_panther.git"
  },
  "kernel": {
    "image_repo": "https://github.com/GrapheneOS/device_google_pantah-kernels_6.1",
    "manifest_repo": "https://github.com/GrapheneOS/kernel_manifest-6.1.git",
    "version": "6.1",
    "fetch_command": "git clone https://gitlab.com/grapheneos/kernel_pixel.git -b \"${GRAPHENEOS_VERSION}\" --recurse-submodules --shallow-submodules --depth=1 kernel",
    "build_command": "KLEAF_REPO_MANIFEST=aosp_manifest.xml ./build_pantah.sh --lto=thin"
  },
  "magisk": {
    "preinit_device": "persist"
  },
  "kernelsu": {
    "repo": "https://github.com/pershoot/KernelSU-Next.git",
    "branch": "dev-susfs"
  },
  "susfs": {
    "branch": "gki-android14-6.1",
    "kernel_patch": "50_add_susfs_in_gki-android14-6.1.patch"
  },
  "grapheneos": {
    "branch": "stable"
  }
}
